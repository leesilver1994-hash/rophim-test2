APP_NAME="Lasotuvi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lasotuvi.uk

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lasotuvi_db
DB_USERNAME=lasotuvi_user
DB_PASSWORD=change_me

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@lasotuvi.uk"
MAIL_FROM_NAME="${APP_NAME}"

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

FRONTEND_URL=https://lasotuvi.uk
SANCTUM_STATEFUL_DOMAINS=lasotuvi.uk,www.lasotuvi.uk
SESSION_DOMAIN=.lasotuvi.uk
